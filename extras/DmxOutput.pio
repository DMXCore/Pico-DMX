; Author: Jostein Løwer, github: jostlowe
; SPDX-License-Identifier: BSD-3-Clause
;
; PIO program for outputting the DMX lighting protocol.
; Compliant with ANSI E1.11-2008 (R2018)
; The program assumes a PIO clock frequency of exactly 1MHz
;
; The break and mark-after-break lengths come first in the TX FIFO, as two words, before
; the frame's bytes (DmxOutput::write puts them there): the break is (first word + 2) us,
; the MAB (second word + 11) us. So any break from 2 us and any MAB from 11 us, in 1 us
; steps.

.program DmxOutput
.side_set 1 opt


; Assert break condition
    pull block  side 1     ; The break length; the line is idle (high) while waiting
    out x, 32   side 0     ; Break starts
breakloop:
    jmp x-- breakloop      ; 1 us per iteration: the break lasts x + 2 us


; Assert mark after break
    pull block  side 1     ; MAB starts: the MAB length
    out x, 32
mabloop:
    jmp x-- mabloop        ; 1 us per iteration, then the 8 us of the first pull below:
                           ; the MAB lasts x + 11 us


; Send data frame
.wrap_target
    pull       side 1 [7]  ; Assert 2 stop bits, or stall with line in idle state
    set x, 7   side 0 [3]  ; Preload bit counter, assert start bit for 4 clocks
bitloop:                   ; This loop will run 8 times (8n1 UART)
    out pins, 1            ; Shift 1 bit from OSR to the first OUT pin
    jmp x-- bitloop   [2]  ; Each loop iteration is 4 cycles.
.wrap
